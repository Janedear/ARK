{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "urgent"
      ],
      "enumColors": [
        "blue",
        "red"
      ],
      "default": "info"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}