{
  "name": "Authority",
  "type": "object",
  "properties": {
    "grant_type": {
      "type": "string",
      "description": "Type of authority granted"
    },
    "granted_to_user": {
      "type": "string",
      "description": "User email receiving authority"
    },
    "granted_by_user": {
      "type": "string",
      "description": "User email granting authority"
    },
    "scope": {
      "type": "string",
      "enum": [
        "national",
        "region_a",
        "region_b",
        "region_c",
        "region_d",
        "system_specific"
      ],
      "description": "Geographic or resource scope"
    },
    "permitted_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reconstitute_systems",
          "reset_trust",
          "coordinate_response",
          "delegate_authority",
          "access_audit_logs",
          "modify_priorities"
        ]
      },
      "description": "What actions this authority permits"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "delegation_permitted": {
      "type": "boolean",
      "default": false,
      "description": "Can this authority be delegated to others"
    },
    "purpose": {
      "type": "string",
      "description": "Reason for this authority grant"
    },
    "parent_authority_id": {
      "type": "string",
      "description": "ID of parent authority if this is a delegation"
    }
  },
  "required": [
    "grant_type",
    "granted_to_user",
    "scope",
    "permitted_actions",
    "valid_until"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.granted_to_user": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}