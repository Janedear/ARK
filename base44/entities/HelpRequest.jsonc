{
  "name": "HelpRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "What is needed"
    },
    "details": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "enumColors": [
        "green",
        "yellow",
        "pink",
        "red"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "done"
      ],
      "enumColors": [
        "red",
        "yellow",
        "green"
      ],
      "default": "open"
    },
    "requester_name": {
      "type": "string"
    },
    "claimed_by": {
      "type": "string",
      "description": "Email of the person handling it"
    },
    "claimed_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}