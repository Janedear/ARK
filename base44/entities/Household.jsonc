{
  "name": "Household",
  "type": "object",
  "properties": {
    "household_name": {
      "type": "string",
      "description": "Household label, e.g. 'The Reyes household'"
    },
    "home_area": {
      "type": "string",
      "description": "Town or neighbourhood only. Never store a full street address."
    },
    "meeting_spot_home": {
      "type": "string",
      "description": "Where to meet if you must leave the home"
    },
    "meeting_spot_neighbourhood": {
      "type": "string",
      "description": "Backup meeting point outside the immediate area"
    },
    "outside_area_plan": {
      "type": "string",
      "description": "Who to contact and where to go if the area must be evacuated"
    },
    "medical_needs": {
      "type": "string",
      "description": "Medication and medical equipment that must be carried"
    },
    "accessibility_needs": {
      "type": "string",
      "description": "Mobility, vision, hearing, cognitive or language support needs"
    },
    "pets": {
      "type": "string",
      "description": "Pets, carriers, food and vaccination records"
    },
    "supplies_notes": {
      "type": "string",
      "description": "Where the kit is kept and what needs replacing"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "household_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}