{
  "name": "Incident",
  "type": "object",
  "properties": {
    "incident_number": {
      "type": "string",
      "description": "Human-readable reference, e.g. INC-2026-12345"
    },
    "title": {
      "type": "string",
      "description": "Incident title"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "credential_compromise",
        "malware",
        "ddos",
        "supply_chain",
        "insider_threat",
        "infrastructure_failure",
        "other"
      ],
      "description": "Type of incident"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "enumColors": [
        "green",
        "yellow",
        "pink",
        "red"
      ],
      "default": "medium",
      "description": "Incident severity"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "analysis",
        "containment",
        "eradication",
        "recovery",
        "resolved",
        "closed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "pink",
        "red",
        "purple",
        "green",
        "gray"
      ],
      "default": "reported",
      "description": "Current response stage (NIST-style lifecycle)"
    },
    "affected_region": {
      "type": "string",
      "enum": [
        "region_a",
        "region_b",
        "region_c",
        "region_d",
        "national",
        "multi_region"
      ],
      "description": "Geographic scope"
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "System IDs affected"
    },
    "description": {
      "type": "string",
      "description": "Detailed incident description"
    },
    "response_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy: actions taken in response"
    },
    "civilians_affected": {
      "type": "number",
      "description": "Estimated civilian population affected"
    },
    "lead_email": {
      "type": "string",
      "description": "Incident lead responsible for the response"
    },
    "resolution_summary": {
      "type": "string",
      "description": "How the incident was resolved"
    },
    "lessons_learned": {
      "type": "string",
      "description": "Post-incident review findings"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "incident_type",
    "severity",
    "affected_region"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.lead_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}