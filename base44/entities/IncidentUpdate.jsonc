{
  "name": "IncidentUpdate",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Incident this entry belongs to"
    },
    "kind": {
      "type": "string",
      "enum": [
        "status_change",
        "note",
        "action_added",
        "action_updated",
        "action_completed"
      ],
      "enumColors": [
        "purple",
        "gray",
        "blue",
        "yellow",
        "green"
      ],
      "description": "Type of timeline entry"
    },
    "from_status": {
      "type": "string"
    },
    "to_status": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "What happened or why"
    },
    "actor_email": {
      "type": "string",
      "description": "Who made the change"
    }
  },
  "required": [
    "incident_id",
    "kind",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}