{
  "name": "SupplyItem",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "water",
        "food",
        "power",
        "medical",
        "tools",
        "documents",
        "pets",
        "communication"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "gray",
        "purple",
        "pink",
        "blue"
      ],
      "default": "water"
    },
    "label": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "packed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "household_id",
    "label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}