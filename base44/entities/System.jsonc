{
  "name": "System",
  "type": "object",
  "properties": {
    "system_name": {
      "type": "string",
      "description": "Name of the system"
    },
    "system_type": {
      "type": "string",
      "enum": [
        "healthcare",
        "power_grid",
        "water",
        "telecommunications",
        "emergency_services",
        "financial",
        "transportation",
        "government"
      ],
      "description": "Type of critical infrastructure"
    },
    "region": {
      "type": "string",
      "enum": [
        "region_a",
        "region_b",
        "region_c",
        "region_d",
        "national"
      ],
      "description": "Geographic region"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "degraded",
        "compromised",
        "offline",
        "reconstituting",
        "verified"
      ],
      "default": "operational",
      "description": "Current system status"
    },
    "population_affected": {
      "type": "number",
      "description": "Number of civilians dependent on this system"
    },
    "time_to_critical_harm_hours": {
      "type": "number",
      "description": "Hours until system loss causes serious harm"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "System IDs this system depends on"
    },
    "baseline_version": {
      "type": "string",
      "description": "Current baseline configuration version"
    },
    "last_reconstitution_date": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_recovery_hours": {
      "type": "number",
      "description": "Estimated time to reconstitute from baseline"
    }
  },
  "required": [
    "system_name",
    "system_type",
    "region"
  ]
}