{
  "name": "User",
  "type": "object",
  "properties": {
    "home_area": {
      "type": "string",
      "description": "The area this person chose for their local resource list, e.g. 'Asheville, NC'"
    },
    "home_lat": {
      "type": "number",
      "description": "Latitude of the chosen area, used to sort resources by distance"
    },
    "home_lon": {
      "type": "number",
      "description": "Longitude of the chosen area, used to sort resources by distance"
    }
  }
}