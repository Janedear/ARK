# Paste real values, then rename this file to .env
# Copy the function URL and a personal access token from your app's API page
# in the dashboard. Publish the app first, or the URL will not answer.

ARK_FUNCTION_URL=
ARK_TOKEN=
ARK_CHANNEL=local
ARK_ALIAS=radio-relay

# --- Radio bridge (Meshtastic, open source) ---
# Community broker works for testing only. Self-host Mosquitto for real use.
MESH_BROKER_URL=mqtts://mqtt.meshtastic.org:8883
MESH_USERNAME=meshdev
MESH_PASSWORD=large4cats
MESH_ROOT=msh/US
MESH_CHANNEL_NAME=LongFast
MESH_CHANNEL_INDEX=0
MESH_NODE_ID=
MESH_MAX_CHARS=200

# --- SMS bridge (open-source Android gateway on a spare phone) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_TO=
SMS_MAX_CHARS=300

# --- Shared ---
ARK_POLL_MS=60000
ARK_QUEUE_FILE=outbox.json