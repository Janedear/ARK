# ARK Crisis Suite — web server rules (Hostinger / Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.php ARK-CRISIS-SUITE.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use the secure address (needed for offline install and the camera/GPS features).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Runtime data (bug reports, patch file, admin config) is never served.
  RewriteRule ^ark-data(/|$) - [F,L]

  # Friendly and legacy addresses
  RewriteRule ^hub/?$ /hub.html [L]
  RewriteRule ^(ARK\.php|index\.html|landing\.html)$ / [L,R=302,QSD]
</IfModule>

# Hidden files and anything that is not meant for visitors
<FilesMatch "^\.|\.(md|sh|py|mjs|log|bak|sql|zip)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"

  # The app and its offline worker must always be re-checked so fixes reach people quickly.
  <FilesMatch "\.(html|php)$|^service-worker\.js$|^manifest\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
